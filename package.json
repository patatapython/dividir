{
  "name": "dividir",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests e2e playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:int && npm run test:e2e",
    "sim": "vitest run --config vitest.sim.config.ts",
    "sim:http": "node --experimental-strip-types tests/sim/http-probe.ts",
    "sim:visual": "node --experimental-strip-types tests/sim/visual-sweep.ts",
    "showcase": "sh scripts/showcase.sh",
    "contrast": "python3 scripts/contrast.py --pairs docs/design/contrast-pairs.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.8",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.8.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
