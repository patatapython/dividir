# Local development overrides. Copy to `.env` (git- and docker-ignored) only if you
# need to change something: every value below is already the default.
# Next and the Prisma CLI both read this file (prisma.config.ts loads it with Next's
# own loader). A variable set in the shell wins over the file.

# Dev database from `docker compose up -d db` (host port 5433).
DATABASE_URL=postgresql://dividir:dividir@localhost:5433/dividir

# Scratch database `prisma migrate dev` diffs against; never holds data.
# Created by db/init on a fresh volume (see README).
SHADOW_DATABASE_URL=postgresql://dividir:dividir@localhost:5433/dividir_shadow

# Not set here on purpose:
# - Tests and E2E pin their own databases (dividir_test, dividir_e2e); the E2E server
#   is the production build started by scripts/e2e-server.sh with its own settings.
# - TRUST_PROXY=1 belongs only behind a reverse proxy that overwrites
#   X-Forwarded-For (production): with it, the createGroup rate limiter believes
#   that header, so setting it on a directly exposed server lets clients spoof it.
# - Production credentials (POSTGRES_USER, POSTGRES_PASSWORD) come from the deploy
#   platform, never from a file in the repo: see the header of compose.prod.yml.
